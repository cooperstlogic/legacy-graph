{
  "name": "legacy-graph",
  "version": "1.0.0",
  "description": "Self-hosted, local-first genealogy platform: plain YAML and Markdown on disk, versioned by Git, served by an in-memory graph runtime.",
  "keywords": [
    "genealogy",
    "family-tree",
    "gedcom",
    "self-hosted",
    "local-first",
    "graph",
    "yaml",
    "git",
    "fastify",
    "graphology"
  ],
  "homepage": "https://github.com/cooperstlogic/legacy-graph#readme",
  "bugs": {
    "url": "https://github.com/cooperstlogic/legacy-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cooperstlogic/legacy-graph.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Dylan Webster (https://github.com/dylanwebster)",
  "private": true,
  "scripts": {
    "test": "vitest",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "start": "tsx --env-file=.env src/index.ts",
    "test:e2e": "tsx tests/e2e/setup.ts && playwright test",
    "test:visual": "playwright test --config=playwright.config.snapshots.ts",
    "generate:synthetic-data": "tsx scripts/generateSyntheticData.ts",
    "geonames:build": "tsx scripts/buildGeonamesDb.ts",
    "basemap:build": "tsx scripts/buildBasemap.ts",
    "basemap:fonts": "tsx scripts/buildBasemapFonts.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@parcel/watcher": "^2.6.0",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "exif-reader": "^2.0.3",
    "fast-glob": "^3.3.3",
    "fastify": "^5.12.5",
    "flexsearch": "^0.8.212",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.42.3",
    "js-yaml": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.1",
    "p-limit": "^7.3.3",
    "read-gedcom": "^0.3.2",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
