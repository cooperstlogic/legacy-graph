{
  "name": "legacy-graph",
  "version": "1.0.0",
  "description": "Self-hosted, local-first genealogy platform: plain YAML and Markdown on disk, versioned by Git, served by an in-memory graph runtime.",
  "keywords": [
    "genealogy",
    "family-tree",
    "gedcom",
    "self-hosted",
    "local-first",
    "graph",
    "yaml",
    "git",
    "fastify",
    "graphology"
  ],
  "homepage": "https://github.com/dylanwebster/legacy-graph#readme",
  "bugs": {
    "url": "https://github.com/dylanwebster/legacy-graph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dylanwebster/legacy-graph.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "Dylan Webster (https://github.com/dylanwebster)",
  "private": true,
  "scripts": {
    "test": "vitest",
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "start": "tsx --env-file=.env src/index.ts",
    "test:e2e": "tsx tests/e2e/setup.ts && playwright test",
    "test:visual": "playwright test --config=playwright.config.snapshots.ts",
    "generate:synthetic-data": "tsx scripts/generateSyntheticData.ts",
    "geonames:build": "tsx scripts/buildGeonamesDb.ts",
    "basemap:build": "tsx scripts/buildBasemap.ts",
    "basemap:fonts": "tsx scripts/buildBasemapFonts.ts"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "@parcel/watcher": "^2.5.6",
    "async-mutex": "^0.5.0",
    "bcryptjs": "^3.0.3",
    "exif-reader": "^2.0.3",
    "fast-glob": "^3.3.3",
    "fastify": "^5.8.5",
    "flexsearch": "^0.8.212",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "gray-matter": "^4.0.3",
    "isomorphic-git": "^1.37.5",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.9",
    "p-limit": "^7.3.0",
    "read-gedcom": "^0.3.2",
    "remark": "^15.0.1",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "zod": "^4.3.6"
  }
}
